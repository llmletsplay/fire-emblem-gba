+def _normalize_unit_name(name: str) -> str:
+    return (name or "").strip().lower()
+
+
+def _extract_unit_id_token(name: str) -> Optional[str]:
+    """Extract hex id token like '0x3e' from names such as 'Unit 0x3E'."""
+    import re
+    m = re.search(r"0x[0-9a-fA-F]+", name or "")
+    if m:
+        return m.group(0).lower()
+    m = re.search(r"\b(\d+)\b", name or "")
+    return m.group(1) if m else None
+
+
+def _enemy_id_tokens(enemy: Dict) -> List[str]:
+    tokens = []
+    for key in ("id", "char_id", "unit_id", "index"):
+        val = enemy.get(key)
+        if val is None or val == "":
+            continue
+        s = str(val).strip().lower()
+        tokens.append(s)
+        if s.startswith("0x"):
+            try:
+                tokens.append(str(int(s, 16)))
+            except ValueError:
+                pass
+        else:
+            try:
+                tokens.append(f"0x{int(s):x}")
+            except ValueError:
+                pass
+    # Also parse id-like tokens from the display name
+    nid = _extract_unit_id_token(enemy.get("name", ""))
+    if nid:
+        tokens.append(nid)
+    return tokens
+
+
+def _name_match_score(enemy: Dict, name: str) -> int:
+    """Higher is better. 0 = no match.
+
+    Prefer exact / id matches so 'Unit 0x3E' does not weakly hit the wrong unit
+    when many enemies share similar fallback names.
+    """
+    if not name:
+        return 0
+    needle = _normalize_unit_name(name)
+    ename = _normalize_unit_name(enemy.get("name", ""))
+    if not ename and not enemy.get("id"):
+        return 0
+    if needle == ename:
+        return 100
+    id_token = _extract_unit_id_token(name)
+    if id_token:
+        tokens = _enemy_id_tokens(enemy)
+        if id_token in tokens:
+            return 90
+        # Exact 'unit 0x3e' style equality already handled; avoid bare substring.
+    # Whole-name containment only if unique-looking (needle longer than 3)
+    if len(needle) >= 4 and needle in ename:
+        return 40
+    if len(ename) >= 4 and ename in needle:
+        return 35
+    return 0
+
+
+def get_enemy_by_name(
+    enemies: List[Dict],
+    name: str,
+    cursor: Optional[Tuple[int, int]] = None,
+) -> Optional[Dict]:
+    """Find enemy by exact/id match; break ties by proximity to cursor."""
+    if not enemies or not name:
+        return None
+    scored: List[Tuple[int, int, Dict]] = []
+    for e in enemies:
+        score = _name_match_score(e, name)
+        if score <= 0:
+            continue
+        ex, ey = int(e.get("x", 0) or 0), int(e.get("y", 0) or 0)
+        dist = 0
+        if cursor is not None:
+            dist = abs(ex - cursor[0]) + abs(ey - cursor[1])
