+def _port_is_listening(port: int, host: str = "127.0.0.1") -> bool:
+    """Return True if something accepts TCP connections on host:port."""
+    try:
+        with socket.create_connection((host, port), timeout=0.4):
+            return True
+    except OSError:
+        return False
+
+
+def _connect_mgba_socket(port: int, retries: int = 5, delay: float = 1.0):
+    """Connect to the Lua socket server with a finite timeout (never leave timeout=None)."""
+    last_err = None
+    for attempt in range(retries):
+        try:
+            sock = socket.create_connection(("127.0.0.1", port), timeout=2)
+            # Explicit timeout — setblocking(True) alone sets timeout=None and can hang CAP forever.
+            sock.settimeout(2.0)
+            log.info(f"Connected to mGBA scripting server on port {port}")
+            return sock
+        except (ConnectionRefusedError, socket.timeout, OSError) as e:
+            last_err = e
+            log.warning(f"mGBA socket connect attempt {attempt+1}/{retries} failed: {e}")
+            time.sleep(delay)
+    raise RuntimeError(f"Failed to connect to mGBA at 127.0.0.1:{port}: {last_err}")
+
