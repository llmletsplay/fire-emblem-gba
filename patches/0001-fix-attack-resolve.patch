+def reconnect_socket(port: int = None, host: str = "127.0.0.1", timeout: float = 2.0):
+    """Open a fresh connection to the mGBA Lua socket server.
+
+    Caller must discard the old socket. Used when CAP/commands time out or the
+    stream is desynchronized after a failed LOADSTATE.
+    """
+    import os
+    if port is None:
+        try:
+            port = int(os.getenv("FE_MGBA_PORT", "8888"))
+        except Exception:
+            port = 8888
+    log.warning(f"Reconnecting mGBA socket to {host}:{port} ...")
+    sock = socket_module.create_connection((host, port), timeout=timeout)
+    sock.settimeout(SOCKET_TIMEOUT)
+    try:
+        _flush_socket(sock)
+    except Exception:
+        pass
+    log.info(f"Reconnected to mGBA scripting server on port {port}")
+    return sock
