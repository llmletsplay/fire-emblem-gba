# Fire Emblem GBA Agent Harness - Environment Configuration
# Copy this file to .env and fill in the provider settings you need.

# Game selection
# Supported values: fe7, fe8. If FE_GAME is empty, the harness infers it from ROM_FILE
# and also verifies the ROM header through mGBA at runtime.
FE_GAME=fe7
ROM_FILE=FE7.gba
FE_MGBA_PORT=8888
FE_WEBSOCKET_PORT=8765
FE_LOAD_SAVESTATE=false

# FE7 tutorial support
# Keep true for Lyn's Tale tutorial chapters. Set false when starting later chapters.
FE_TUTORIAL=true

# LLM provider selection
# Supported values: OPENAI, ANTHROPIC, CUSTOM, OLLAMA, GEMINI, GROQ, TOGETHER,
# GROK, LMSTUDIO, ZAI.
LLM_PROVIDER=CUSTOM
MODEL_NAME=gpt-4o

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=o3

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# Together
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# xAI Grok
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-3-mini

# Z.AI GLM
Z_AI_API_KEY=your_z_ai_api_key_here
Z_AI_MODEL=glm-4.6

# Local providers
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:27b-it-q4_K_M
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-3-27b

# Custom OpenAI-compatible endpoint
CUSTOM_BASE_URL=http://localhost:8080/v1
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_MODEL=gpt-4o-mini
CUSTOM_TIMEOUT=30
CUSTOM_SUPPORTS_REASONING=false

# Optional vision model. Use this when the main provider cannot process images.
FE_USE_VISION_MODEL=true
VISION_PROVIDER=OPENAI
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=your_vision_api_key_here
VISION_MODEL=gpt-4o-mini

# LLM runtime tuning
LLM_STREAM_TIMEOUT=120
LLM_TOTAL_TIMEOUT=150
FE_MAX_INPUT_TOKENS=100000
FE_MAX_TOKENS=8192
FE_REASONING_EFFORT=high

# Screenshot and vision tuning
FE_SCREENSHOT_CAPTURE_COUNT=3
FE_CAP_TIMEOUT=3.0
FE_CAP_RETRIES=2
FE_CAP_RETRY_DELAY=0.2
FE_TEXT_BOX_DETECTION=true
FE_MOVEMENT_TILE_DETECTION=true

# Optional UI/context tuning
FE_CONTEXT_HINTS_ENABLED=false
FE_IMAGE_DETAIL=high

# MiniMax Code Plus / Token Plan (OpenAI-compatible)
# https://platform.minimax.io/docs/token-plan/quickstart
# LLM_PROVIDER=MINIMAX
# MINIMAX_API_KEY=sk-cp-...
# MINIMAX_MODEL=MiniMax-M2.5
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_SUPPORTS_REASONING=true

# ---------------------------------------------------------------------------
# Live RTMP streaming (optional — leave blank to disable)
# Consumed by lua/stream_wrapper.lua + scripts/stream/ffmpeg-stream.sh
# ---------------------------------------------------------------------------

# Required for streaming. Examples:
#   Twitch:  rtmp://live.twitch.tv/app
#   YouTube: rtmp://a.rtmp.youtube.com/live2
#   Kick:    rtmp://fa011.contribute.live-video.net/app
RTMP_URL=

# Per-platform ingest key from your live dashboard
STREAM_KEY=

# FIFO plumbing (defaults shown)
STREAM_FIFO_DIR=/tmp
STREAM_VIDEO_FIFO=/tmp/fe-stream.video
STREAM_AUDIO_FIFO=/tmp/fe-stream.audio

# Per-component kill switches (set to "off" to disable)
STREAM_VIDEO=on
STREAM_AUDIO=on

# Encoder tuning (defaults shown — good for 1080p30 on a 2 vCPU box)
STREAM_BITRATE=6000k
STREAM_PRESET=veryfast
STREAM_RESOLUTION=1920x1080
STREAM_FPS=60
STREAM_AUDIO_RATE=128k

# Encoder personality.
#   STREAM_TUNE         - x264 -tune value. animation (default, best quality
#                         for game content) or zerolatency (sub-frame
#                         lookahead off, slightly worse compression).
#   STREAM_LOW_LATENCY  - "on" sets -bf 0 + -flush_packets 1 and forces tune
#                         to zerolatency for the lowest RTMP latency (~2-3s
#                         on Twitch). "off" (default) uses -bf 2 + tune
#                         animation for better compression at ~3-4s latency.
STREAM_TUNE=animation
STREAM_LOW_LATENCY=off

# Supervisor behaviour (scripts/stream/supervisor-stream.sh)
#   STREAM_STABLE_RUNTIME   seconds an ffmpeg run must last to count as
#                           "stable". A run shorter than this increments
#                           the rapid-failure counter.
#   STREAM_BACKOFF_INITIAL  seconds to sleep before the first restart.
#   STREAM_BACKOFF_MAX      ceiling on the per-restart backoff.
#   STREAM_MAX_RAPID_FAILS  after this many short runs in a row the
#                           supervisor gives up, tails the ffmpeg log,
#                           and exits non-zero so systemd Restart=on-failure
#                           can pick it up after the operator fixes it.
STREAM_STABLE_RUNTIME=60
STREAM_BACKOFF_INITIAL=5
STREAM_BACKOFF_MAX=60
STREAM_MAX_RAPID_FAILS=5

# ---------------------------------------------------------------------------
# Stream health check (scripts/healthcheck/healthcheck.sh)
# Polls Twitch Helix /streams every 60s via a systemd timer; posts a Discord
# webhook alert when the stream is down past HEALTHCHECK_OFFLINE_THRESHOLD,
# and another every HEALTHCHECK_ALERT_COOLDOWN until it recovers.
# ---------------------------------------------------------------------------

# Register a Twitch app at https://dev.twitch.tv/console/apps — put the
# Client ID + Secret here. Required for the healthcheck to call Helix.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Your Twitch username, lowercase. The healthcheck looks up YOUR stream only.
TWITCH_CHANNEL_LOGIN=

# Discord webhook URL. Create one in a Discord channel: ⚙ Channel Settings →
# Integrations → Webhooks → New Webhook → Copy URL. For phone push, enable
# Discord notifications for that channel on your phone.
DISCORD_WEBHOOK_URL=

# Tunables (defaults shown).
#   HEALTHCHECK_OFFLINE_THRESHOLD  seconds the stream must be offline before
#                                  the first DOWN alert is sent. Filters out
#                                  one-off Twitch API blips.
#   HEALTHCHECK_ALERT_COOLDOWN     seconds between repeat DOWN alerts while
#                                  the stream stays offline.
#   HEALTHCHECK_TEST_ALERT         "on" → on first run, send a TEST message
#                                  so you can verify the Discord webhook.
HEALTHCHECK_OFFLINE_THRESHOLD=120
HEALTHCHECK_ALERT_COOLDOWN=600
HEALTHCHECK_TEST_ALERT=off
