# Fire Emblem GBA Agent Harness - Environment Configuration
# Copy this file to .env and fill in the provider settings you need.

# Game selection
# Supported values: fe7, fe8. If FE_GAME is empty, the harness infers it from ROM_FILE
# and also verifies the ROM header through mGBA at runtime.
FE_GAME=fe7
ROM_FILE=FE7.gba
FE_MGBA_PORT=8888
FE_WEBSOCKET_PORT=8765
FE_LOAD_SAVESTATE=false

# FE7 tutorial support
# Keep true for Lyn's Tale tutorial chapters. Set false when starting later chapters.
FE_TUTORIAL=true

# LLM provider selection
# Supported values: OPENAI, ANTHROPIC, CUSTOM, OLLAMA, GEMINI, GROQ, TOGETHER,
# GROK, LMSTUDIO, ZAI.
LLM_PROVIDER=CUSTOM
MODEL_NAME=gpt-4o

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=o3

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# Together
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# xAI Grok
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-3-mini

# Z.AI GLM
Z_AI_API_KEY=your_z_ai_api_key_here
Z_AI_MODEL=glm-4.6

# Local providers
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:27b-it-q4_K_M
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-3-27b

# Custom OpenAI-compatible endpoint
CUSTOM_BASE_URL=http://localhost:8080/v1
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_MODEL=gpt-4o-mini
CUSTOM_TIMEOUT=30
CUSTOM_SUPPORTS_REASONING=false

# Optional vision model. Use this when the main provider cannot process images.
FE_USE_VISION_MODEL=true
VISION_PROVIDER=OPENAI
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=your_vision_api_key_here
VISION_MODEL=gpt-4o-mini

# LLM runtime tuning
LLM_STREAM_TIMEOUT=120
LLM_TOTAL_TIMEOUT=150
FE_MAX_INPUT_TOKENS=100000
FE_MAX_TOKENS=8192
FE_REASONING_EFFORT=high

# Screenshot and vision tuning
FE_SCREENSHOT_CAPTURE_COUNT=3
FE_CAP_TIMEOUT=3.0
FE_CAP_RETRIES=2
FE_CAP_RETRY_DELAY=0.2
FE_TEXT_BOX_DETECTION=true
FE_MOVEMENT_TILE_DETECTION=true

# Optional UI/context tuning
FE_CONTEXT_HINTS_ENABLED=false
FE_IMAGE_DETAIL=high
